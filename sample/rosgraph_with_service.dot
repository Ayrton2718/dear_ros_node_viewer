digraph graphname {
	graph [bb="0,0,800,200",
		compound=True,
		rank=same,
		rankdir=LR,
		ranksep=0.2
	];
	node [label="\N"];
	t___topic_test	[URL=topic_3A__topic_test,
		height=0.5,
		label="/topic_test",
		pos="200,100",
		shape=box,
		tooltip="topic:/topic_test",
		width=1.8611];
	n___node_pub	[URL=__node_pub,
		height=0.5,
		label="/node_pub",
		pos="50,100",
		shape=ellipse,
		tooltip="/node_pub",
		width=1.5346];
	n___node_sub	[URL=__node_sub,
		height=0.5,
		label="/node_sub",
		pos="350,100",
		shape=ellipse,
		tooltip="/node_sub",
		width=1.5346];
	s___service_test	[URL=service_3A__service_test,
		height=0.5,
		label="/service_test",
		pos="200,50",
		shape=doubleoctagon,
		tooltip="service:/service_test",
		width=1.8611];
	n___node_client	[URL=__node_client,
		height=0.5,
		label="/node_client",
		pos="50,50",
		shape=ellipse,
		tooltip="/node_client",
		width=1.5346];
	n___node_server	[URL=__node_server,
		height=0.5,
		label="/node_server",
		pos="350,50",
		shape=ellipse,
		tooltip="/node_server",
		width=1.5346];
	n___node_pub -> t___topic_test	[edgetooltip="Publisher"];
	t___topic_test -> n___node_sub	[edgetooltip="Subscription"];
	n___node_client -> s___service_test	[edgetooltip="Service Client"];
	s___service_test -> n___node_server	[edgetooltip="Service Server"];
}
